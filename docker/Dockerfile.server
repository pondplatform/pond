FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /pond-server ./cmd/pond-server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /pond-server /usr/local/bin/pond-server
ENTRYPOINT ["pond-server"]
