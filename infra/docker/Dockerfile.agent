FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /pond-agent ./cmd/pond-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl bash
# Install Helm
RUN curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
# Install OpenTofu
RUN apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community opentofu
COPY --from=builder /pond-agent /usr/local/bin/pond-agent
COPY tofu-providers/ /opt/pond/tofu-providers/
ENTRYPOINT ["pond-agent"]
