FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.work go.work.sum* ./
COPY shared/go.mod shared/go.sum* ./shared/
COPY server/go.mod server/go.sum* ./server/
COPY agent/go.mod agent/go.sum* ./agent/
COPY cli/go.mod cli/go.sum* ./cli/
RUN --mount=type=cache,target=/root/go/pkg/mod \
    cd agent && go mod download
COPY shared/ ./shared/
COPY agent/ ./agent/
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /pond-agent ./agent/

FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl bash
# Install Helm 4
RUN curl -fsSL https://get.helm.sh/helm-v4.1.4-linux-amd64.tar.gz | tar -xz -C /usr/local/bin --strip-components=1 linux-amd64/helm
# Install OpenTofu
RUN apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community opentofu
COPY --from=builder /pond-agent /usr/local/bin/pond-agent
COPY infra/agent/helm-charts/ /opt/pond/helm-charts/
COPY infra/agent/tofu-providers/ /opt/pond/tofu-providers/
ENTRYPOINT ["pond-agent"]
