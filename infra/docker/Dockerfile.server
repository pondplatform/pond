FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/root/go/pkg/mod \
    go mod download
COPY cmd/pond-server/ cmd/pond-server/
COPY internal/common/ internal/common/
COPY internal/server/ internal/server/
COPY db/ db/
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /pond-server ./cmd/pond-server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /pond-server /usr/local/bin/pond-server
ENTRYPOINT ["pond-server"]
